{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ashioto-cloudflare-workers",
  "compatibility_date": "2025-08-03",
  "main": "./src/index.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ashioto",
      "database_id": "6cf9fed2-ee13-4c83-8a04-84ae76c5793e",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "JWT_SECRET": "your-jwt-secret-key-change-this-in-production",
    "SPOTIFY_CLIENT_ID": "your-spotify-client-id",
    "SPOTIFY_CLIENT_SECRET": "your-spotify-client-secret",
    "SPOTIFY_REDIRECT_URI": "your-spotify-redirect-uri",
    "SPOTIFY_REDIRECT_STATE": "your-spotify-redirect-state",
    "YOLP_ID": "your-yolp-id",
    "SPOTIFY_REDIRECT_URI_PATH": "/api/auth/callback",
    "SPOTIFY_SCOPE": "user-read-private user-read-email user-read-currently-playing",

  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
